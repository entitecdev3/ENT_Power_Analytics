<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="idEditIdentityDialog" class="sapUiResponsiveMargin">
    <VBox class="sapUiSmallMargin" >
      <Label required="true" text="{i18n>USERNAME_LABEL}"/>
      <Input width="98%" value="{username}" />
      <Label required="true" text="{i18n>ROLES}" />
      <Input width="98%" value="{roles}" />
    </VBox>
    <buttons>
      <Button text="{i18n>ok}" type="Emphasized" press="onSaveEditIdentityDialog" />
      <Button text="{i18n>cancel}" press="onCloseEditIdentityDialog" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
